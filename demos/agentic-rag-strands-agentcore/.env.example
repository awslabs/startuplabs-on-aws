# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default

# Bedrock Knowledge Base (from infrastructure/setup_knowledge_base.py)
KNOWLEDGE_BASE_ID=your-knowledge-base-id-here
KNOWLEDGE_BASE_REGION=us-east-1

# S3 Bucket for knowledge base documents (must be globally unique)
S3_BUCKET_NAME=your-unique-bucket-name

# Model Configuration
INFERENCE_MODEL_ID=mistral.mistral-large-3-675b-instruct
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# AgentCore Memory (persistent cross-session memory) - from setup_memory.py
AGENTCORE_MEMORY_ID=your-memory-id-here

# Deployed AgentCore Runtime (from `agentcore status` after deploy)
AGENTCORE_RUNTIME_ARN=
AGENTCORE_RUNTIME_REGION=us-east-1

# OpenSearch Serverless network access (security)
# Default is non-public (VPC-scoped). For production, set VPC endpoint IDs:
OPENSEARCH_VPC_ENDPOINTS=
# For local experimentation ONLY (not recommended): allow public access
OPENSEARCH_ALLOW_PUBLIC=false

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agentic-rag-demo
