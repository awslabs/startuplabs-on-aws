@@ -0,0 +1,42 @@
+"""buy_product through HTTP with every adapter on the AWS Emulator."""
+
+from __future__ import annotations
+
+import ssl
+import uuid
+
+import httpx
+from fastapi.testclient import TestClient
+
+from tests.credentials import PASSWORD
+
+
+def test_buy_product_on_the_emulator(api: TestClient) -> None:
+    email = f"buyer-{uuid.uuid4().hex[:8]}@example.com"
+    api.post("/api/v1/auth/register", json={"email": email, "password": PASSWORD, "name": "B"})
+    tokens = api.post("/api/v1/auth/login", json={"email": email, "password": PASSWORD}).json()
+    h = {"authorization": f"Bearer {tokens['access_token']}"}
+
+    stock = {p["id"]: p["stock"] for p in api.get("/api/v1/orders/products", headers=h).json()}
+    r = api.post(
+        "/api/v1/orders/purchases", headers=h, json={"product_id": "sku-coffee", "quantity": 1}
+    )
+    assert r.status_code == 201, r.text
+    order = r.json()
+    after = {p["id"]: p["stock"] for p in api.get("/api/v1/orders/products", headers=h).json()}
+    assert after["sku-coffee"] == stock["sku-coffee"] - 1
+
+    too_many = api.post(
+        "/api/v1/orders/purchases",
+        headers=h,
+        json={"product_id": "sku-grinder", "quantity": stock["sku-grinder"] + 1},
+    )
+    assert too_many.status_code == 409
+
+    url = api.get(f"/api/v1/orders/purchases/{order['id']}/receipt", headers=h).json()["url"]
+    settings = api.app.state.settings  # type: ignore[attr-defined]
+    ca = ssl.create_default_context(
+        cafile=str(settings.emulator_home / str(settings.emulator_port) / "ca.pem")
+    )
+    receipt = httpx.get(url, verify=ca).json()
+    assert receipt["order_id"] == order["id"] and receipt["quantity"] == 1
diff --git a/tests/unit/test_orders.py b/tests/unit/test_orders.py
new file mode 100644
index 0000000..d170f12
--- /dev/null
+++ b/tests/unit/test_orders.py
@@ -0,0 +1,79 @@
+from __future__ import annotations
+
+from fastapi.testclient import TestClient
+
+from app.modules.orders.contract import ProductPurchased
+from app.platform.facades import Platform
+from app.strangler import Owner
+from tests.conftest import register_and_login
+
+
+def _stock(client: TestClient, headers: dict[str, str], sku: str) -> int:
+    products = client.get("/api/v1/orders/products", headers=headers).json()
+    return next(p["stock"] for p in products if p["id"] == sku)
+
+
+def test_buy_product(client: TestClient, platform: Platform) -> None:
+    seen: list[ProductPurchased] = []
+    platform.events.subscribe(ProductPurchased, seen.append)
+    headers = register_and_login(client)
+    before = _stock(client, headers, "sku-mug")
+
+    r = client.post(
+        "/api/v1/orders/purchases", headers=headers, json={"product_id": "sku-mug", "quantity": 3}
+    )
+
+    assert r.status_code == 201, r.text
+    order = r.json()
+    assert order["total_cents"] == 3 * 3990
+    assert _stock(client, headers, "sku-mug") == before - 3
+    assert [o["id"] for o in client.get("/api/v1/orders/purchases", headers=headers).json()] == [
+        order["id"]
+    ]
+    assert seen and seen[0].order_id == order["id"]
+    receipt = client.get(f"/api/v1/orders/purchases/{order['id']}/receipt", headers=headers)
+    assert receipt.status_code == 200
+
+
+def test_insufficient_stock_rolls_back(client: TestClient) -> None:
+    headers = register_and_login(client)
+    r = client.post(
+        "/api/v1/orders/purchases",
+        headers=headers,
+        json={"product_id": "sku-grinder", "quantity": 3},  # only 2 in stock
+    )
+    assert r.status_code == 409
+    assert r.json()["error"] == "conflict"
+    assert _stock(client, headers, "sku-grinder") == 2
+    assert client.get("/api/v1/orders/purchases", headers=headers).json() == []
+
+
+def test_unknown_product_and_bad_quantity(client: TestClient) -> None:
+    headers = register_and_login(client)
+    missing = client.post(
+        "/api/v1/orders/purchases", headers=headers, json={"product_id": "nope", "quantity": 1}
+    )
+    assert missing.status_code == 404
+    zero = client.post(
+        "/api/v1/orders/purchases", headers=headers, json={"product_id": "sku-mug", "quantity": 0}
+    )
+    assert zero.status_code == 422
+
+
+def test_requires_auth_and_hides_other_users_receipts(client: TestClient) -> None:
+    assert client.post("/api/v1/orders/purchases", json={}).status_code == 401
+    alice = register_and_login(client, "alice@example.com")
+    bob = register_and_login(client, "bob@example.com")
+    order = client.post(
+        "/api/v1/orders/purchases", headers=alice, json={"product_id": "sku-mug", "quantity": 1}
+    ).json()
+    url = f"/api/v1/orders/purchases/{order['id']}/receipt"
+    assert client.get(url, headers=bob).status_code == 404
+
+
+def test_strangler_routes_purchases_to_the_monolith(client: TestClient) -> None:
+    table = client.app.state.routes  # type: ignore[attr-defined]
+    assert table.owner_of("/api/v1/orders/purchases") is Owner.MODERN
+    assert table.owner_of("/api/v1/orders/products") is Owner.MODERN
+    assert table.owner_of("/api/v1/orders") is Owner.LEGACY  # old order history
+    assert table.owner_of("/api/v1/orders/o-1001") is Owner.LEGACY
