--- /dev/null
+++ b/src/app/modules/orders/infrastructure.py
@@ -0,0 +1,66 @@
+from __future__ import annotations
+
+from datetime import UTC, datetime
+
+from app.modules.orders.domain import Order, Product
+from app.platform.ports.database import Row
+from app.repository import SqlRepository
+
+
+class ProductRepository(SqlRepository[Product]):
+    table = "products"
+
+    def to_row(self, entity: Product) -> Row:
+        return {
+            "id": entity.id,
+            "name": entity.name,
+            "price_cents": entity.price_cents,
+            "stock": entity.stock,
+        }
+
+    def from_row(self, row: Row) -> Product:
+        return Product(row["id"], row["name"], int(row["price_cents"]), int(row["stock"]))
+
+    def take_stock(self, product_id: str, quantity: int) -> int | None:
+        """Atomic decrement. Returns the new stock, or None if there was not enough.
+
+        The check and the write are one statement, so two concurrent buyers can
+        never oversell (no read-modify-write in Python).
+        """
+        rows = self.db.execute(
+            "UPDATE products SET stock = stock - :q WHERE id = :id AND stock >= :q RETURNING stock",
+            {"q": quantity, "id": product_id},
+        )
+        return int(rows[0]["stock"]) if rows else None
+
+
+class OrderRepository(SqlRepository[Order]):
+    table = "orders"
+
+    def to_row(self, entity: Order) -> Row:
+        return {
+            "id": entity.id,
+            "user_id": entity.user_id,
+            "product_id": entity.product_id,
+            "quantity": entity.quantity,
+            "total_cents": entity.total_cents,
+            "created_at": entity.created_at,
+        }
+
+    def from_row(self, row: Row) -> Order:
+        created = datetime.fromisoformat(str(row["created_at"])[:19]).replace(tzinfo=UTC)
+        return Order(
+            row["id"],
+            row["user_id"],
+            row["product_id"],
+            int(row["quantity"]),
+            int(row["total_cents"]),
+            created,
+        )
+
+    def for_user(self, user_id: str, limit: int = 50) -> list[Order]:
+        rows = self.db.execute(
+            "SELECT * FROM orders WHERE user_id = :u ORDER BY created_at DESC, id LIMIT :l",
+            {"u": user_id, "l": limit},
+        )
+        return [self.from_row(r) for r in rows]
