+from __future__ import annotations
+
+from datetime import datetime
+
+from fastapi import APIRouter, status
+from pydantic import BaseModel, Field
+
+from app.modules.identity.contract import CurrentPrincipal
+from app.modules.orders.application import OrderService
+from app.modules.orders.domain import MAX_QUANTITY, Order, Product
+
+
+class BuyProductIn(BaseModel):
+    product_id: str = Field(min_length=1, max_length=64)
+    quantity: int = Field(ge=1, le=MAX_QUANTITY)
+
+
+class ProductOut(BaseModel):
+    id: str
+    name: str
+    price_cents: int
+    stock: int
+
+    @classmethod
+    def of(cls, p: Product) -> ProductOut:
+        return cls(id=p.id, name=p.name, price_cents=p.price_cents, stock=p.stock)
+
+
+class OrderOut(BaseModel):
+    id: str
+    product_id: str
+    quantity: int
+    total_cents: int
+    created_at: datetime
+
+    @classmethod
+    def of(cls, o: Order) -> OrderOut:
+        return cls(
+            id=o.id,
+            product_id=o.product_id,
+            quantity=o.quantity,
+            total_cents=o.total_cents,
+            created_at=o.created_at,
+        )
+
+
+class UrlOut(BaseModel):
+    url: str
+
+
+def build_router(service: OrderService) -> APIRouter:
+    router = APIRouter(tags=["orders"])
+
+    @router.get("/api/v1/orders/products")
+    def catalog(_principal: CurrentPrincipal) -> list[ProductOut]:
+        return [ProductOut.of(p) for p in service.catalog()]
+
+    @router.post("/api/v1/orders/purchases", status_code=status.HTTP_201_CREATED)
+    def buy_product(principal: CurrentPrincipal, body: BuyProductIn) -> OrderOut:
+        return OrderOut.of(service.buy_product(principal, body.product_id, body.quantity))
+
+    @router.get("/api/v1/orders/purchases")
+    def my_orders(principal: CurrentPrincipal) -> list[OrderOut]:
+        return [OrderOut.of(o) for o in service.my_orders(principal)]
+
+    @router.get("/api/v1/orders/purchases/{order_id}/receipt")
+    def receipt(principal: CurrentPrincipal, order_id: str) -> UrlOut:
+        return UrlOut(url=service.receipt_url(principal, order_id))
+
+    return router
diff --git a/src/app/modules/orders/application.py b/src/app/modules/orders/application.py
