--- /dev/null
+++ b/src/app/modules/orders/application.py
@@ -0,0 +1,69 @@
+"""buy_product and friends. Orchestrates repositories, storage and events; no HTTP, no boto3."""
+
+from __future__ import annotations
+
+import json
+import logging
+
+from app.modules.orders.contract import ProductPurchased
+from app.modules.orders.domain import Order, Product
+from app.modules.orders.infrastructure import OrderRepository, ProductRepository
+from app.platform.facades import StorageFacade
+from app.platform.ports.database import SqlDatabase
+from app.shared import errors
+from app.shared.events import EventBus
+from app.shared.principal import Principal
+
+log = logging.getLogger(__name__)
+
+
+class OrderService:
+    def __init__(self, db: SqlDatabase, storage: StorageFacade, events: EventBus) -> None:
+        self._db = db
+        self._storage = storage
+        self._events = events
+
+    def catalog(self) -> list[Product]:
+        return ProductRepository(self._db).list()
+
+    def buy_product(self, principal: Principal, product_id: str, quantity: int) -> Order:
+        # One transaction: stock decrement and order row commit or roll back together.
+        with self._db.transaction() as tx:
+            products, orders = ProductRepository(tx), OrderRepository(tx)
+            product = products.get(product_id)
+            if product is None:
+                raise errors.NotFound(f"product {product_id}")
+            order = Order.place(principal.subject, product, quantity)  # validates quantity
+            if products.take_stock(product_id, quantity) is None:
+                raise errors.Conflict("insufficient stock")
+            orders.add(order)
+        # After commit: side effects that must not happen for a rolled-back order.
+        self._storage.save(
+            f"receipts/{principal.subject}/{order.id}.json",
+            json.dumps(
+                {
+                    "order_id": order.id,
+                    "product": product.name,
+                    "quantity": order.quantity,
+                    "total_cents": order.total_cents,
+                    "created_at": order.created_at.isoformat(),
+                }
+            ).encode(),
+            "application/json",
+        )
+        self._events.publish(
+            ProductPurchased(
+                order.id, order.user_id, order.product_id, order.quantity, order.total_cents
+            )
+        )
+        log.info("product purchased", extra={"order_id": order.id})
+        return order
+
+    def my_orders(self, principal: Principal) -> list[Order]:
+        return OrderRepository(self._db).for_user(principal.subject)
+
+    def receipt_url(self, principal: Principal, order_id: str) -> str:
+        key = f"receipts/{principal.subject}/{order_id}.json"
+        if self._storage.load(key) is None:  # also hides other users' receipts
+            raise errors.NotFound(f"order {order_id}")
+        return self._storage.download_url(key)
