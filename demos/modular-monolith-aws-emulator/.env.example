# Copy to .env (git-ignored). Every APP_* setting is documented in src/app/config.py.
APP_PLATFORM_TARGET=emulator
APP_AWS_REGION=us-east-1
APP_HOST=127.0.0.1
APP_PORT=8080
APP_RESOURCE_PREFIX=sup
# Emulator
EMULATOR_PORT=9297
# AWS Emulator sends anonymous usage telemetry by default. Set to off to opt out.
EMULATOR_TELEMETRY=on
