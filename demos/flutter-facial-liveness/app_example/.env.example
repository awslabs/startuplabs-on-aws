# Copy to dart_defines.json (gitignored) or pass each as --dart-define at build.
# These are NOT secrets baked into source — they are injected at build time.
# The API key value in particular must never be committed.

# From the RekognitionBackendStack CDK outputs:
REKOGNITION_API_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/prod/
REKOGNITION_API_KEY=<retrieve-with: aws apigateway get-api-key --api-key <ApiKeyId> --include-value>
IDENTITY_POOL_ID=<region>:<uuid>
AWS_REGION=us-east-1
